{
  "swagger": "2.0",
  "info": {
    "title": "API TP5",
    "description": "Documentación de la API para el TP5.",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "tags": [
    {
      "name": "Socios",
      "description": "Operaciones relacionadas con los socios."
    },
    {
      "name": "Transacciones",
      "description": "Operaciones relacionadas con las transacciones"
    }
  ],
  "schemes": [
    "http",
    "https"
  ],
  "paths": {
    "/api/socio/": {
      "get": {
        "tags": [
          "Socios"
        ],
        "summary": "Obtener todos los socios",
        "description": "Retorna una lista de todos los socios.",
        "responses": {
          "200": {
            "description": "Lista de socios obtenida con éxito."
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Socios"
        ],
        "summary": "Agrega un socio",
        "description": "Agrega un socio a la lista de socios",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Datos del socio a agregar.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Socio"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Socio agregado correctamente.",
            "schema": {
              "$ref": "#/definitions/Socio"
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      },
      "put": {
        "tags": [
          "Socios"
        ],
        "summary": "Actualizar un Socio",
        "description": "Actualiza un socio de la lista de Socios.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "example": "any"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Socio actualizado con éxito."
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/socio/{id}": {
      "delete": {
        "tags": [
          "Socios"
        ],
        "summary": "Eliminar un Socio",
        "description": "Elimina un socio de la lista de Socios.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Socio eliminado con éxito."
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/socio/activos": {
      "get": {
        "tags": [
          "Socios"
        ],
        "summary": "Filtrar socios activos",
        "description": "Retorna la lista de socios activos.",
        "responses": {
          "200": {
            "description": "Lista de socios activos obtenida con exito."
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/transacciones/": {
      "get": {
        "tags": [
          "Transacciones"
        ],
        "summary": "Obtener las transacciones",
        "description": "Retorna la lista de transacciones.",
        "responses": {
          "200": {
            "description": "Lista de transacciones obtenida con exito."
          },
          "400": {
            "description": "Bad Request"
          }
        }
      },
      "post": {
        "tags": [
          "Transacciones"
        ],
        "summary": "Agrega una Transaccion",
        "description": "Agrega una transaccion a la lista de transacciones",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Datos de la transaccion a agregar.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Transaccion"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaccion agregado correctamente.",
            "schema": {
              "$ref": "#/definitions/Transaccion"
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/transacciones/{email}": {
      "get": {
        "tags": [
          "Transacciones"
        ],
        "summary": "Filtrar transacciones por email",
        "description": "Retorna la lista de transacciones segun el email ingresado",
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de transacciones con email ingresado obtenida con exito."
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/transacciones/{idiomaOrigen}/{idiomaDestino}": {
      "get": {
        "tags": [
          "Transacciones"
        ],
        "summary": "Filtrar transacciones por lenguaje de origen y destino.",
        "description": "Retorna la lista de transacciones segun el origen y destino.",
        "parameters": [
          {
            "name": "idiomaOrigen",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "idiomaDestino",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de transacciones obtenida con exito."
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "definitions": {
    "Socio": {
      "type": "object",
      "properties": {
        "nombre": {
          "type": "string",
          "example": "Guadalupe"
        },
        "apellido": {
          "type": "string",
          "example": "Veliz"
        },
        "foto": {
          "type": "string",
          "example": "url"
        },
        "dni": {
          "type": "string",
          "example": "12345678"
        },
        "numeroSocio": {
          "type": "number",
          "example": 1
        },
        "activo": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "Transaccion": {
      "type": "object",
      "properties": {
        "idiomaOrigen": {
          "type": "string",
          "example": "ES"
        },
        "textoOrigen": {
          "type": "string",
          "example": "Hola"
        },
        "idiomaDestino": {
          "type": "string",
          "example": "EN"
        },
        "textoDestino": {
          "type": "string",
          "example": "Hello"
        },
        "emailCliente": {
          "type": "string",
          "example": "alguien@mail.com"
        }
      }
    }
  }
}